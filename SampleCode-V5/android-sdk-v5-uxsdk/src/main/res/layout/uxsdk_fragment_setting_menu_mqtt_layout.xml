<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/uxsdk_mqtt_setting_title"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/uxsdk_mqtt_broker_settings"
            android:textColor="#333333"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/et_mqtt_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                android:background="@android:color/white"
                android:hint="@string/uxsdk_mqtt_broker_host"
                android:inputType="text"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_mqtt_port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:hint="@string/uxsdk_mqtt_broker_port"
                android:inputType="number"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_mqtt_client_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@android:color/white"
            android:hint="@string/uxsdk_mqtt_client_id"
            android:inputType="text"
            android:padding="8dp"
            android:singleLine="true"
            android:textColor="#333333"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/et_mqtt_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:hint="@string/uxsdk_mqtt_username"
                android:inputType="text"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_mqtt_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:hint="@string/uxsdk_mqtt_password"
                android:inputType="textPassword"
                android:padding="8dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/uxsdk_mqtt_topic_settings"
            android:textColor="#333333"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_mqtt_flight_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@android:color/white"
            android:hint="@string/uxsdk_mqtt_flight_topic"
            android:inputType="text"
            android:padding="8dp"
            android:singleLine="true"
            android:textColor="#333333"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_mqtt_psdk_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@android:color/white"
            android:hint="@string/uxsdk_mqtt_psdk_topic"
            android:inputType="text"
            android:padding="8dp"
            android:singleLine="true"
            android:textColor="#333333"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/uxsdk_mqtt_data_source"
            android:textColor="#333333"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_mqtt_flight_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uxsdk_mqtt_enable_flight_data"
            android:textColor="#333333"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cb_mqtt_psdk_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/uxsdk_mqtt_enable_psdk_data"
            android:textColor="#333333"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/uxsdk_mqtt_frequency"
            android:textColor="#333333"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rg_mqtt_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <RadioButton
                android:id="@+id/rb_mqtt_1hz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/uxsdk_mqtt_1hz"
                android:textColor="#333333"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_mqtt_5hz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/uxsdk_mqtt_5hz"
                android:textColor="#333333"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_mqtt_10hz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/uxsdk_mqtt_10hz"
                android:textColor="#333333"
                android:textSize="12sp" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btn_mqtt_connect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/uxsdk_bg_flight_data_button_gray"
                android:text="@string/uxsdk_mqtt_connect"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_mqtt_disconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/uxsdk_bg_flight_data_button_gray"
                android:enabled="false"
                android:text="@string/uxsdk_mqtt_disconnect"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_mqtt_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/uxsdk_mqtt_status_disconnected"
            android:textColor="#666666"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btn_mqtt_start_forward"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/uxsdk_bg_flight_data_button_gray"
                android:enabled="false"
                android:text="@string/uxsdk_mqtt_start_forward"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_mqtt_stop_forward"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/uxsdk_bg_flight_data_button_gray"
                android:enabled="false"
                android:text="@string/uxsdk_mqtt_stop_forward"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/uxsdk_mqtt_preview"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_mqtt_preview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@android:color/white"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:text="@string/uxsdk_mqtt_no_data"
            android:textColor="#333333"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/uxsdk_mqtt_message_log"
                android:textColor="#333333"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_mqtt_clear"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/uxsdk_bg_flight_data_button_gray"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/uxsdk_mqtt_clear"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_mqtt_message_log"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@android:color/white"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:text="@string/uxsdk_mqtt_no_messages"
            android:textColor="#333333"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
