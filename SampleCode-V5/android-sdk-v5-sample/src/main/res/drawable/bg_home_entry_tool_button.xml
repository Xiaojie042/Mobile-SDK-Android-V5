<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/home_entry_button_disabled_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/home_entry_button_disabled_stroke" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/home_entry_tool_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/white_40_percent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/home_entry_tool_start"
                android:endColor="@color/home_entry_tool_end" />
            <stroke
                android:width="1dp"
                android:color="@color/white_40_percent" />
        </shape>
    </item>
</selector>
